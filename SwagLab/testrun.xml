<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Swag Labs Test Suite" parallel="tests" >
    <listeners>
    <listener class-name="utils.ReportListener"/>
    </listeners>
    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="tests.LoginTest"/>
            <class name="tests.InventoryTest"/>
            <class name="tests.CheckoutTest"/>
            <class name="tests.Cart"/>
        </classes>
    </test>
    <test name="Edge Tests" enabled="false">
        <parameter name="browser" value="Edge"/>
        <classes>
            <class name="tests.LoginTest"/>
            <class name="tests.InventoryTest"/>
        </classes>
    </test>

    <test name="Firefox Tests" enabled="false">
        <parameter name="browser" value="firefox" />
        <classes>
            <class name="tests.LoginTest"/>
            <class name="tests.InventoryTest"/>
        </classes>
    </test>

</suite>